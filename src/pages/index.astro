---
import Layout from "../layouts/Layout.astro";
import socialLinks from "../data/socialLink.js";
import { filterPost } from "../js/utils";
import BlogCard from "../components/BlogCard.astro";

const allPosts = Object.values(import.meta.glob("./../pages/blog/post*.md", { eager: true }));

const filterPosts = filterPost(allPosts, {
  filterOutDrafts: true,
  filterOutFuturePosts: true,
  sortByDate: true,
  limit: 2,
});
// const profilePicture = "../../public/images/mypfp-removebg.png";
const profilePicture =
  "https://media-hosting.imagekit.io//d52f65ea0b7b4861/mypfp2.jpg?Expires=1835372646&Key-Pair-Id=K2ZIVPTIP2VGHC&Signature=ITH1ZYUn6L4uONiLznQfL0Ef~SOlL82OsVbVotfVvyJNsOhFmHao~7bidsWvcbO078af6uzH2Mj5JoRJdddcpQttsttXVsdWwx2SzpRcg8RZcTXYGFjK01rqqG6cZmvy9iFGevz6a2rV5pZMdJuHjJPNLt956tf1UF4uw9sb51sDxZlVpl~vKl~d52uu0E96AsPYn1RU8-DrohD8t8qVZyMDTY0u8rjxMrHFUjI-B7TtIL66SOWvOlVJRnVVsDnkC1iiLXkHEukenFXVPOs6TLCIDyvcLrUyHZ9b2KXqzLCKt4ULddtW2AnTqrD9yppbcraqucci9IryqCZcxju6wA__";
const { title, desc, image, frontmatter, robots } = Astro.props;
---

<Layout title={title} description={desc} {image} {frontmatter} {robots}>
  <div class="profile">
    <div class="snowflakes" aria-hidden="true">
      <div class="snowflake">❅</div>
      <div class="snowflake">❆</div>
      <div class="snowflake">❅</div>
      <div class="snowflake">❆</div>
      <div class="snowflake">❅</div>
      <div class="snowflake">❆</div>
      <div class="snowflake">❅</div>
      <div class="snowflake">❆</div>
      <div class="snowflake">❅</div>
      <div class="snowflake">❆</div>
    </div>
    <div class="profile__container">
      <img src={profilePicture} class="profile__picture" />
      <div class="profile__details">
        <h1>Anurag Gupta</h1>
        <p>
          I am a passionate developer. I am always eager to learn new things and
          explore new technologies. I am currently pursuing my B.Tech in
          Computer Science and Engineering from LNCT Bhopal
        </p>
        <div class="socail-link">
          {
            socialLinks.map((link) => (
              <a href={link.url + link.username}>
                <img class="social-link__icon" src={link.svg} alt={link.name} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <div >
    <h3 class="recent_posts_title" >Recent Posts</h3>
<div class="recent_posts">
  
   {
     filterPosts.map((post: any) => (
       <BlogCard isImage={false} {...post.frontmatter} url={post.url} />
     ))
   }
</div>
  </div>
</Layout>

<style>

  body {
    background-color: #ffffffb3;
  }
  .blog-container {
    /* width: 250px; */
  }
  h1 {
    font-size: 3rem;
    text-decoration: underline;
  }
  @media (max-width: 768px) {
    .profile__details {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    h1 {
      font-size: 2.3rem;
      text-align: center;
    }
    p {
      text-align: left;
    }
    h1,
    p {
      padding: 0.7rem;
      margin: 0%;
      /* text-align:right; */
    }
    .profile {
      justify-content: center;
      padding: 0%;
    }
    .profile__container {
      display: flex;
      /* background-color: antiquewhite; */
      justify-self: center;
      flex-direction: column;
      /* padding-bottom: 4em; */
    }
  }
  p {
    line-height: 1.3rem;
    text-align: center;
    font-size: larger;
    font-weight: 700;
    font-family: monospace;
  }

  .socail-link {
    padding-top: 1rem;
    display: flex;
    gap: 1em;
    justify-content: center;
  }
  .social-link__icon {
    width: 35px;
    height: 35px;
  }
  img {
    filter: grayscale(50%);
    border-radius: 40%;
    width: 250px;
    height: 250px;
  }
  .profile {
    width: 100%;
    display: flex;
    align-items: center;
    /* height: 100%; */
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 3rem 0 0rem 0;
    justify-content: center;
    /* position: relative; */
    overflow: hidden;
  }
  .profile__container {
    display: flex;
    align-items: center;
  }
  .profile__details {
    flex: 1 0;
  }
  .profile__details > h1 {
    margin-top: 0;
  }
  .profile__picture {
    border-radius: 50%;
    margin: 0 2rem 1rem 0;
    align-self: center;
    filter: grayscale(50%);
  }
  .snowflakes {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .snowflake {
    position: absolute;
    top: -10px;
    color: white;
    font-size: 1em;
    user-select: none;
    animation: fall 10s linear infinite;
  }
  .snowflake:nth-child(1) {
    left: 10%;
    animation-duration: 8s;
    animation-delay: 0s;
  }
  .snowflake:nth-child(2) {
    left: 20%;
    animation-duration: 10s;
    animation-delay: 2s;
  }
  .snowflake:nth-child(3) {
    left: 30%;
    animation-duration: 12s;
    animation-delay: 4s;
  }
  .snowflake:nth-child(4) {
    left: 40%;
    animation-duration: 14s;
    animation-delay: 6s;
  }
  .snowflake:nth-child(5) {
    left: 50%;
    animation-duration: 16s;
    animation-delay: 8s;
  }
  .snowflake:nth-child(6) {
    left: 60%;
    animation-duration: 18s;
    animation-delay: 10s;
  }
  .snowflake:nth-child(7) {
    left: 70%;
    animation-duration: 20s;
    animation-delay: 12s;
  }
  .snowflake:nth-child(8) {
    left: 80%;
    animation-duration: 22s;
    animation-delay: 14s;
  }
  .snowflake:nth-child(9) {
    left: 90%;
    animation-duration: 24s;
    animation-delay: 16s;
  }
  .snowflake:nth-child(10) {
    left: 100%;
    animation-duration: 26s;
    animation-delay: 18s;
  }
  @keyframes fall {
    0% {
      top: -10%;
      transform: translateX(0);
    }
    100% {
      top: 100%;
      transform: translateX(20px);
    }
  }
  .recent_posts_title {
    padding-top: 1em;
    border-bottom: #bdbdbd 2px solid;
  }
  .recent_posts {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 1em;
  }
  .blog-container {
    
    width: 30%;
  }
</style>
