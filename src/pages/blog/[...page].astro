---
import type { GetStaticPaths } from "astro";

import BlogCard from "../../components/BlogCard.astro";
import Layout from "../../layouts/Layout.astro";
import { filterPost } from "../../js/utils";
import Paginate from "../../components/Paginate.astro";

const { frontmatter } = Astro.props;
// const { image } = frontmatter;

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allPosts = Object.values(
    import.meta.glob("./post*.md", { eager: true })
  );

  const filterPosts = filterPost(allPosts, {
    filterOutDrafts: true,
    filterOutFuturePosts: true,
    sortByDate: true,
    limit: 20,
  });

  return paginate(filterPosts, { pageSize: 4 });
}

interface PageProps {
  page: {
    url: any;
    data: Array<{ frontmatter: any; url: string }>;
  };
}

const { page } = Astro.props as PageProps;
console.log(frontmatter);

---

<Layout
  title="Blog"
  description="Blog page"
  robots={false}
>
  <!-- <pre> {JSON.stringify(...post.frontmatter, null, 2)}</pre> -->

  <h2>Latest Blogs</h2>
  <pre>
    <!-- {JSON.stringify(page, null, 2)} -->
  </pre>
  <div class="post-container">
    <!-- <BlogCard {...allPosts} url={imgf}/> -->

    {
      page.data.map((post: any) => (
        <BlogCard {...post.frontmatter} url={post.url} />
      ))
    }
    <Paginate prev={page.url.prev} next={page.url.next} />
  </div>
</Layout>

<style>
  ul li {
    list-style: none;
    /* border: 5px; */
  }
  .post-container {
    display: flex;
    justify-content: center;
    gap: 1em;
    flex-wrap: wrap;
  }
  .blogposts > img {
    height: 50%;
  }
  h2 {
    text-align: center;
    font: 2em;
  }
</style>
