---
import Layout from "../../../layouts/Layout.astro";

title: 'Color Changer Project'
description: 'A simple web app to change background color.'

const {title= "Color Changer Project", description = "A simple web app to change background color."} = Astro.props;
---

<Layout title={title} description={description}>
    <h1>{title}</h1>
    <p>{description}</p>
    <p>for javascript pratice level 1</p>

    <div id="parent">
        <div class="child" id="yellow">yellow</div>
        <div class="child" id="green">green</div>
        <div class="child" id="red">red</div>
        <div class="child" id="blue">blue</div>
    </div>
    <div id="colorchange">
        <p>To Change Background Color Click Above Buttons</p>
    </div>
    <script>
         const yellowElement = document.querySelectorAll(".child");
         
     yellowElement.forEach((eer, s) => {
            const er = document.getElementById(eer.id)
            console.log(er);
            
            er?.addEventListener('click' , e => {
                const prar = er.id;
                console.log(prar);
                const p = document.getElementById("colorchange")
                // prar
               if (p) p.style.backgroundColor = prar
                
                
            })
            
         });
   
         
    </script>
</Layout>

<style>
    #parent {
        display: flex;
        flex-direction: row;
        justify-content: center;
        justify-content: space-around;
        margin-top: 20px;
    }
    #colorchange {
        margin: 2%;
        height: 50%;
        border: 3px solid black;

    }
    .child {
        width: 100px;
        height: 100px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 20px;
        cursor: pointer;
    }

    #yellow {
        background-color: rgb(255, 255, 3);
    }

    #green {
        background-color: green;
    }

    #red {
        background-color: red;
    }

    #blue {
        background-color: blue;
    }
</style>