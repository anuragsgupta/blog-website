---
import {Image} from "astro:assets";
const {url, title, description, author, pubDate,image,category } = Astro.props;
const {width="600", height="600/2.5", isImage=true}= Astro.props;
import { formatDate, slugify } from "../js/utils";
---

<div class="blog-container">
    <span>
      <a href= {`/category/${slugify(category)}`}>
        <h4 >{category}</h4>
      </a>
    </span>
  <a href={url}>
   {isImage && <Image src={image.url || image.src} alt={image.alt} class="blog-image"
    width={width} height={height} format="webp"/>}
    <div class="blog-content">
      <h3 class="blog-title">{title}</h3>
      <p class="blog-meta">by <span><a href={`/author/${slugify(author)}`}>{author}</a></span> on {formatDate( pubDate)}</p>
      <p class="blog-description">{description}</p>
    </div>
  </a>
</div>

<style>
    a:hover {
    text-decoration: underline;
    color: #699ac6;
  }
a {
  text-decoration: none;
  color: inherit;
}

h4 {
  margin: 0.5em;
  padding-left: 0.5em;
  border-bottom: rgb(215, 215, 215) solid 2px;
}
.blog-container {
  /* width: fit-content; */
  /* height: 50%; */
  width: 500px;
  flex-wrap: wrap;
  /* background-color: rgba(223, 223, 223,0.3); */
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  transition: transform 0.2s;

}

.blog-container:hover {
  transform: translateY(-5px);
}

.blog-image {
  /* width: 100%;
  height: 250px; */
  border-bottom: 3px solid #ddd;
  border-radius: 5px;
  height: 30vh;

}

.blog-content {
  padding: 7px;
}

.blog-title {
  margin: 0;
  font-size: 1.1em;
  color: #333;
}

.blog-meta {
  margin: 5px 0;
  font-size: 0.9em;
  color: #777;
}

.blog-description {
  margin: 10px 0 0;
  font-size: 1em;
  color: #555;
  line-height: 1.5;
  text-wrap: wrap;
}
</style>