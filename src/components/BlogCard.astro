---
const {url, title, description, author, pubDate,image } = Astro.props;

---

<div class="blog-container">
  <a href={url}>
    <img src={image.url || image.src} alt={image.alt} class="blog-image" />
    <div class="blog-content">
      <h3 class="blog-title">{title}</h3>
      <p class="blog-meta">by {author} on {pubDate}</p>
      <p class="blog-description">{description}</p>
    </div>
  </a>
</div>

<style>
a {
  text-decoration: none;
  color: inherit;
}

.blog-container {
  /* width: fit-content; */
  /* height: 50%; */
  width:500px;
  flex-wrap: wrap;
  background-color: #dfdfdf;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  transition: transform 0.2s;

}

.blog-container:hover {
  transform: translateY(-5px);
}

.blog-image {
  width: 100%;
  height: 250px;
  border-bottom: 3px solid #ddd;
  border-radius: 5px;
}

.blog-content {
  padding: 7px;
}

.blog-title {
  margin: 0;
  font-size: 1.5em;
  color: #333;
}

.blog-meta {
  margin: 5px 0;
  font-size: 0.9em;
  color: #777;
}

.blog-description {
  margin: 10px 0 0;
  font-size: 1em;
  color: #555;
  line-height: 1.5;
  text-wrap: wrap;
}
</style>