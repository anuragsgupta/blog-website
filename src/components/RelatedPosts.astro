---
import { formatDate, slugify } from "../js/utils";


const { relPosts } = Astro.props;

---

<div>
    <pre>
        <!-- {JSON.stringify(relPosts, null, 2)} -->
    </pre>
    <h3>Related Posts</h3>
    {
        relPosts.map((post: any) => {
          return (  <div class="related-post">
                <h4><a href={post.url}>{post.frontmatter.title}</a></h4>
                <p><a href={`/author/${slugify(post.frontmatter.author)}`}>{post.frontmatter.author}</a> - {formatDate( post.frontmatter.pubDate)}</p>
            </div>)
        } )
    }

</div>

<style>
    h4,p {
        padding: 0%;
        margin: 0.0%;
        
    }
    p {
        
       padding: 0.5em 0em;
    }
    a {
        /* text-decoration: none; */
        text-decoration: unset;
        color: unset;
    }
    a:hover {
        text-decoration: underline;
        color: #824646;
    }
    .related-post {
        display: block;
        /* background-color: whitesmoke; */
        padding: 1vh 1em;
        margin-bottom: 0.1em;
        /* background-color: #dfdfdf; */
        /* border-bottom: black solid 2px; */
    }
</style>