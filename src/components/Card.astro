---
export type Props = {
    to: string;
    title: string;
    gradientFrom: string;
    gradientTo: string;
}
const {title, to} = Astro.props;

---
<a href={to} class="card"> 
    <div class="class_inner">
        <div class="class_title">{title} &raar;</div>
    
    </div>
        

</a>


<style>
.card > .class_inner  {
padding: 1.5rem;
display: block;
font-size: 1.0rem;
background-color: rgb(172, 172, 13);
}


</style>