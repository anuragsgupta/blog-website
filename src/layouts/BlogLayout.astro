---
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
const { title, description, pubDate, author, image, tags } = frontmatter;
---

<Layout title={title} description={description}>
  <header>
    <div class="post-header">
      <h1>{title}</h1>
      <p>by {author} - {pubDate}</p>
      <p>
        tags:
        {tags ? tags.map((item: string) => <span> {item} </span>) : "none"}
      </p>
      <img src={image.url || image.src} alt={image.alt}  />
      <article>  
          <slot />
        </article>
    </div>
  </header>
</Layout>
<style>
    header {
        width: 95%;
        display: flex;
        margin: auto;
        
    }
 article {
    font-family:'Courier New', Courier, monospace
    font-size: 1rem;
    /* text-align: justify; */
    line-height: 1.7rem;
 }
 h1 {
 font-family:'Segoe UI', Tahoma, Geneva, Verdana;
 
}
p {
    color: rgb(107, 107, 107);
}
img {
    width: 100%;
    height: 40%;
    
}

</style>
