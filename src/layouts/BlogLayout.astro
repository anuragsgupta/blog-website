---
import RelatedPosts from "../components/RelatedPosts.astro";
import { filterPost, formatDate, slugify } from "../js/utils";
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
const { title, description, pubDate, author, image, tags, category } = frontmatter;

const allposts = await Astro.glob("../pages/blog/post*.md");
const formattedPost = filterPost(allposts);
const relatedPosts = formattedPost
  .filter((post: { frontmatter: { category: string; title: string; }; }) => post.frontmatter.category === category && post.frontmatter.title !== title)
  
---

<Layout title={title} description={description} image={image}
frontmatter={frontmatter}
robots={false} >
  <header>

    <div class="post-header">
      <h1>{title}</h1>
      <p> <strong>author: </strong><a href={`/author/${slugify( author)}`}>{author}</a></p>
      <p><strong>Publish:</strong> {formatDate( pubDate)}</p>
      <!-- <p>
        <strong>tags:</strong>
        {tags ? tags.map((item: string) => <span> {item} </span>) : "none"}
      </p> -->
      <p><strong>catergory:</strong> <a href={`/category/${slugify( category)}`}>{category}</a></p>
      <img src={image.url || image.src} alt={image.alt}  />
      <article>  
          <slot />
        </article>
        <RelatedPosts relPosts={relatedPosts} />
    </div>
  </header>
</Layout>
<style>
    header {
        width: 95%;
        display: flex;
        margin: auto;
        
    }
 article {
    font-family:'Courier New', Courier, monospace
    /* font-size: 0.5rem; */
    /* text-align: justify; */
    line-height: 1.7rem;
 }
 h1 {
 font-family:'Segoe UI', Tahoma, Geneva, Verdana;
 
}
p {
    color: rgb(107, 107, 107);
    font-size:smaller;
    line-height: 90%;
}
img {
    width: 100%;
   
    
}

</style>
